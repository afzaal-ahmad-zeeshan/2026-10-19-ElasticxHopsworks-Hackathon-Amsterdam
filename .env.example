# Which cluster to use: local | remote
CLUSTER=local

# Local cluster
LOCAL_ELASTICSEARCH_URL=http://localhost:9200
LOCAL_ELASTICSEARCH_API_KEY=your_local_base64_api_key
# or basic auth instead of an API key:
# LOCAL_ELASTICSEARCH_USERNAME=elastic
# LOCAL_ELASTICSEARCH_PASSWORD=changeme

# Remote cluster (Elastic Cloud)
REMOTE_ELASTICSEARCH_URL=https://your-deployment.es.region.elastic.cloud:443
REMOTE_ELASTICSEARCH_API_KEY=your_remote_base64_api_key

# What to ingest
F1_SEASONS=2024
F1_SESSION_TYPES=Race,Qualifying
